# Synthesis engine: "edge" (default; Microsoft Edge neural voices, no API key),
# "elevenlabs" (ElevenLabs V3; needs ELEVENLABS_API_KEY) or "voicestudio"
# (cloned voices from the local VoiceStudio app; a voice needs a `voicestudio`
# profile id in voices.json, otherwise it speaks through Edge).
SPEAK_ENGINE=edge

# Edge voice for names without an `edge` mapping in voices.json
# (default: en-IE-EmilyNeural)
EDGE_TTS_VOICE=

# VoiceStudio API address (default: http://127.0.0.1:3900) and diffusion steps
# (default: 32, full quality; 8 is about 3x faster)
VOICESTUDIO_URL=
VOICESTUDIO_STEPS=

# ElevenLabs API key (required only when SPEAK_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=

# Default ElevenLabs voice ID (optional — falls back to Claude voice from voices.json)
ELEVENLABS_VOICE_ID=

# Cache directory for replayed audio (default: ./cache)
SPEAK_CACHE_DIR=

# HTTP port for daemon + dashboard (default: 7865)
SPEAK_PORT=
