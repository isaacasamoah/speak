# Synthesis engine: "edge" (default; Microsoft Edge neural voices, no API key)
# or "elevenlabs" (ElevenLabs V3; needs ELEVENLABS_API_KEY).
SPEAK_ENGINE=edge

# Edge voice for names without an `edge` mapping in voices.json
# (default: en-IE-EmilyNeural)
EDGE_TTS_VOICE=

# ElevenLabs API key (required only when SPEAK_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=

# Default ElevenLabs voice ID (optional — falls back to Claude voice from voices.json)
ELEVENLABS_VOICE_ID=

# Cache directory for replayed audio (default: ./cache)
SPEAK_CACHE_DIR=

# HTTP port for daemon + dashboard (default: 7865)
SPEAK_PORT=
